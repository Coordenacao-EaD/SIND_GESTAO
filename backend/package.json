{
  "name": "sind-gestao-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/config test/database/database-config.test.ts test/modules/site-home/content-integrity.test.ts test/modules/site-home/site-home-version.service.test.ts",
    "test:db": "vitest run test/database/postgresql.infrastructure.test.ts test/database/editorial-migrations.infrastructure.test.ts test/database/reviews-versions-migrations.infrastructure.test.ts test/database/f3.1-final-acceptance.infrastructure.test.ts test/modules/site-home/site-home.repository.integration.test.ts test/modules/site-home/site-home-version.service.integration.test.ts",
    "db:help": "dbmate --help",
    "db:version": "dbmate --version",
    "db:new": "dbmate --migrations-dir db/migrations --schema-file db/schema.sql new",
    "db:status": "dbmate --migrations-dir db/migrations --schema-file db/schema.sql status",
    "db:up": "dbmate --migrations-dir db/migrations --schema-file db/schema.sql up",
    "db:down": "dbmate --migrations-dir db/migrations --schema-file db/schema.sql down"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.21.0",
    "dbmate": "2.35.0",
    "oxlint": "1.78.0",
    "testcontainers": "12.1.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
